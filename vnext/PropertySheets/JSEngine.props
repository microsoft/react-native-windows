<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <JsEnginePropsDefined>true</JsEnginePropsDefined>
    <!-- Enabling this will (1) Include hermes glues in the Microsoft.ReactNative binaries AND (2) Make hermes the default engine -->
    <UseHermes Condition="'$(UseHermes)' == ''">true</UseHermes>
    <!-- This will be true if (1) the client want to use hermes by setting UseHermes to true OR (2) We are building for UWP where dynamic switching is enabled -->
    <HermesVersion Condition="'$(HermesVersion)' == ''">0.0.0-2608.12001-35d34796</HermesVersion>
    <HermesPackageName Condition="'$(HermesPackageName)' == ''">Microsoft.JavaScript.Hermes</HermesPackageName>
    <HermesPackage Condition="'$(HermesPackage)' == '' And Exists('$(PkgMicrosoft_JavaScript_Hermes)')">$(PkgMicrosoft_JavaScript_Hermes)</HermesPackage>
    <HermesPackage Condition="'$(HermesPackage)' == ''">$(NuGetPackageRoot)\$(HermesPackageName)\$(HermesVersion)</HermesPackage>
    <EnableHermesInspectorInReleaseFlavor Condition="'$(EnableHermesInspectorInReleaseFlavor)' == ''">false</EnableHermesInspectorInReleaseFlavor>
    <!-- Disable linking Hermes into the output in cases where we need to fully rely on HermesShim -->
    <HermesNoLink Condition="'$(HermesNoLink)' == '' and '$(Configuration)' == 'Release' and '$(EnableHermesInspectorInReleaseFlavor)' != 'true'">true</HermesNoLink>
    <!-- Use Hermes bytecode bundles provided by metro hermes compiler when available -->
    <EnableDevServerHBCBundles Condition="'$(EnableDevServerHBCBundles)' == ''">false</EnableDevServerHBCBundles>

    <UseV8 Condition="'$(UseV8)' == ''">false</UseV8>
    <V8Version Condition="'$(V8Version)' == ''">0.79.5</V8Version>
    <V8PackageName>ReactNative.V8Jsi.Windows</V8PackageName>
    <V8PackageName Condition="'$(V8AppPlatform)' != 'win32'">$(V8PackageName).UWP</V8PackageName>
    <V8Package>$(NuGetPackageRoot)\$(V8PackageName).$(V8Version)</V8Package>
    <V8Platform Condition="'$(Platform)' == 'ARM64EC'">x64</V8Platform>

    <!--
      Microsoft.JavaScript.V8 provides the V8 JSI ABI (v8_jsi_abi_* C functions), selected only by the
      ReactNative.ReactOptions/JSIEngineV8Abi property to load v8jsi2.dll. We use only its headers and consumer-side
      sources: the functions are resolved at runtime with GetProcAddress, so the package's build targets (import lib,
      DLL copy, source injection) are excluded.
      The headers are identical in all RID packages, so the win-x64 package is used for all platforms.
    -->
    <V8AbiPackageName>Microsoft.JavaScript.V8.win-x64</V8AbiPackageName>
    <V8AbiVersion Condition="'$(V8AbiVersion)' == ''">26.1.2</V8AbiVersion>
    <V8AbiPackage Condition="'$(V8AbiPackage)' == '' And Exists('$(PkgMicrosoft_JavaScript_V8_win-x64)')">$(PkgMicrosoft_JavaScript_V8_win-x64)</V8AbiPackage>
    <V8AbiPackage Condition="'$(V8AbiPackage)' == ''">$(NuGetPackageRoot)\microsoft.javascript.v8.win-x64\$(V8AbiVersion)</V8AbiPackage>
    <V8AbiJsiDir>$(V8AbiPackage)\build\native\jsi\</V8AbiJsiDir>
    <V8AbiIncludeDir>$(V8AbiPackage)\build\native\include\</V8AbiIncludeDir>
  </PropertyGroup>

</Project>
