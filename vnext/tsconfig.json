{
  "extends": "@rnw-scripts/ts-config",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": ".",
    "rootDir": "src-win",
    "moduleSuffixes": [".windows", ".native", ""],
    "paths": {
      "react-native": ["."], // this mapping is relative to "baseUrl"
      "react-native/types/*": ["../node_modules/react-native/types_DEPRECATED/*"]
    }
  },
  "include": ["src-win"],
  "exclude": ["node_modules"]
}
