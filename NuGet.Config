<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  <packageSources>
    <clear />
    <!-- Use PackageFeedProxy for nuget.org packages and restrict the ADO feed to the V8 mappings below. -->
    <add key="PackageFeedProxy" value="https://packagefeedproxy.microsoft.io/nuget/v3/index.json" />
    <add key="react-native" value="https://pkgs.dev.azure.com/ms/react-native/_packaging/react-native-public/nuget/v3/index.json" />

    <!-- For local internal WindowsAppSDK builds, run vnext\Scripts\EnableInternalWinAppSDKFeed.ps1
         to add both the internal source and its package mapping. -->
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="PackageFeedProxy">
      <package pattern="*" />
    </packageSource>
    <packageSource key="react-native">
      <package pattern="ReactNative.V8Jsi.Windows*" />
      <package pattern="Microsoft.JavaScript.V8*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
