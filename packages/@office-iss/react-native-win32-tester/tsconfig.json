{
  "extends": "@rnw-scripts/ts-config",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".",
    "paths": {
      "react-native": [
        "../react-native-win32"
      ], // this mapping is relative to "baseUrl"
      "react-native/types/*": [
        "../../../node_modules/react-native/types_DEPRECATED/*"
      ]
    },
    // Some code copied from react-native-win32 is not strict clean
    "noImplicitAny": false,
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ],
}